# Lightroom API Credentials
ADOBE_CLIENT_ID=your_client_id
ADOBE_CLIENT_SECRET=your_client_secret
ADOBE_REFRESH_TOKEN=your_refresh_token

# Application Config
MONITOR_DIR=/photos
ALBUM_NAME=Server_Auto_Upload
CHECK_INTERVAL=10

# Self-service re-authentication web endpoint. Must exactly match a redirect URI
# registered in the Adobe Developer Console for this project.
OAUTH_REDIRECT_BASE_URL=https://lightroomsync.anomaly.cx
WEB_PORT=5000

# Optional: Discord webhook to alert on authentication failure/recovery.
DISCORD_WEBHOOK_URL=
