# Lightroom API Credentials
ADOBE_CLIENT_ID=your_client_id
ADOBE_CLIENT_SECRET=your_client_secret
# Not required to start the container -- leave unset. Authenticate (first time
# and any time after) via OAUTH_REDIRECT_BASE_URL/auth/start instead; the token
# is then written to data/refresh_token.txt automatically.
# ADOBE_REFRESH_TOKEN=

# Application Config
MONITOR_DIR=/photos
ALBUM_NAME=Server_Auto_Upload
CHECK_INTERVAL=10

# OAuth2 authentication web endpoint (used for both first-time setup and later
# re-authentication). Must exactly match the redirect URI registered as both
# "Default redirect URI" and "Redirect URI pattern" in the Adobe Developer
# Console for this project (see README).
OAUTH_REDIRECT_BASE_URL=https://lightroomsync.anomaly.cx
WEB_PORT=5000

# Optional: Discord webhook to alert on authentication failure/recovery.
DISCORD_WEBHOOK_URL=
